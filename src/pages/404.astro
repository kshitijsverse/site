---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" path="/404">
  <section class="section">
    <div class="wrap">
      <h1 class="page-title">This stop isn't on the line</h1>
      <p class="lede">The page you asked for doesn't exist. It may have moved, or the link has a typo.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-quiet" href="/learn/">See the course line</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-title { font-size: var(--step-3); font-weight: 850; margin-bottom: 1rem; }
</style>
